# Saga configuration. Copy to .env, fill in what you use, and keep .env private (chmod 600).
# Every connector is optional: Saga turns features on for whatever is configured.
# Values containing spaces must be quoted (deploy scripts may source this file with bash).

# ---------------------------------------------------------------------------- core
# Where the admin UI is reached (used for links and cookies).
PUBLIC_URL=http://localhost:8080
# 32+ random bytes, base64. Signs sessions and encrypts stored secrets (indexer/provider credentials).
# Generate: openssl rand -base64 32      Losing it means re-entering stored secrets.
SAGA_SECRET_KEY=
# First admin account, created on first start only. Change the password in Settings afterwards.
SAGA_ADMIN_USER=admin
SAGA_ADMIN_PASSWORD=
# Reverse proxies whose X-Forwarded-For / X-Real-IP Saga trusts (comma-separated). Add your proxy's IP.
TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1

# ---------------------------------------------------------------------------- media stack
# API keys: Settings → General in each app. Plex token: see https://support.plex.tv (X-Plex-Token).
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
SAB_URL=http://sabnzbd:8080
SAB_API_KEY=
# SABnzbd's "minimum free space for downloads", for storage forecasts.
SAB_MIN_FREE_GB=500
# Quality profile (by name) used when no add rule picks one, e.g. a profile Recyclarr maintains.
# Unset: the profile with the most scored custom formats. Stock profiles are never the default.
DEFAULT_MOVIE_PROFILE=
DEFAULT_TV_PROFILE=
PLEX_URL=http://plex:32400
PLEX_TOKEN=
TAUTULLI_URL=
TAUTULLI_API_KEY=
# Only needed to import users and requests from Overseerr/Jellyseerr/Seerr.
SEERR_URL=
SEERR_API_KEY=

# ---------------------------------------------------------------------------- discovery
# Required for Discover/Browse: free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Optional: Trakt lists.
TRAKT_CLIENT_ID=
# Region for "where to stream" filters (ISO 3166-1).
WATCH_REGION=US
# Optional natural-language discover ("90s heist films I don't have"). Costs API usage; off when unset.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
NL_MODEL=

# ---------------------------------------------------------------------------- request portal (optional)
# The portal runs as a second container with ONLY these; see docs/portal.md.
# Shared secret between the admin process and the portal: openssl rand -base64 48
INTERNAL_SECRET=
INTERNAL_PORT=3001
INTERNAL_URL=http://saga:3001
PORTAL_PUBLIC_URL=https://requests.example.com
# Web push: generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email (magic links, notifications) via Resend.
RESEND_API_KEY=
MAIL_FROM="Saga Requests <saga@example.com>"
# Cloudflare Tunnel token, if you expose the portal with `docker compose --profile tunnel up -d`.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------- optional SSH integrations
# See docs/integrations.md. Keys are mounted at /ssh in the container; each target pins the key to one
# forced command, so these keys can't run anything else.
# Read-only status feed from the download host (PP guard state, disks, leftovers, log tails).
FEED_HOST=
# Mount points in the download host's disk feed: your media pool and your download cache (storage tiles, forecast).
MEDIA_MOUNT=/mnt/media
CACHE_MOUNT=/mnt/cache
# Read-only status feed from a maintenance agent (journal, log tail).
FEED_AGENT_HOST=
FEED_SSH_KEY=/ssh/id_ed25519
FEED_KNOWN_HOSTS=/ssh/known_hosts
# Stack updates (Stack page) via deploy/hosts/download-host/saga-ops. Use a separate key.
OPS_STACK_HOST=
OPS_SSH_KEY=/ssh/ops_ed25519
# "Ask the agent" via deploy/hosts/agent-host/saga-agent-task. Read the warning in docs/integrations.md first.
OPS_AGENT_HOST=

# ---------------------------------------------------------------------------- runtime
PORT=3000
DATA_DIR=./data
# Set to 0 to disable background polling (tests, offline development).
POLLING=1
